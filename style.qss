/* ==========================================================================
   STMS Professional Executive Theme (Dark Obsidian & Corporate Blue)
   ========================================================================== */

/* Global Default Styles */
QWidget {
    background-color: #0B0F19;
    color: #F8FAFC;
    font-family: "Segoe UI Variable Display", "Segoe UI", "Inter", -apple-system, sans-serif;
    font-size: 11pt;
}

/* Push Buttons */
QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 11pt;
}
QPushButton:hover {
    background-color: #3B82F6;
}
QPushButton:pressed {
    background-color: #1D4ED8;
}
QPushButton:disabled {
    background-color: #1E293B;
    color: #64748B;
}

/* Line Edit (Text Input) */
QLineEdit {
    background-color: #1E293B;
    color: #FFFFFF;
    border: 1.5px solid #475569;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 24px;
    min-width: 220px;
    font-size: 11pt;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}
QLineEdit:focus {
    border: 1.5px solid #38BDF8;
    background-color: #0F172A;
}
QLineEdit::placeholder {
    color: #CBD5E1;
}

/* Checkboxes */
QCheckBox {
    spacing: 10px;
    background: transparent;
    color: #F8FAFC;
    font-size: 11pt;
}
QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid #475569;
    border-radius: 6px;
    background-color: #0F172A;
}
QCheckBox::indicator:checked {
    background-color: #2563EB;
    border: 2px solid #2563EB;
}
QCheckBox::indicator:hover {
    border: 2px solid #3B82F6;
}

/* Table View & Data Grid */
QTableWidget, QTableView {
    background-color: #0F172A;
    alternate-background-color: #131C31;
    color: #F8FAFC;
    gridline-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
    outline: none;
}
QTableWidget::item, QTableView::item {
    padding: 6px 10px;
    border-bottom: 1px solid #1E293B;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #2563EB;
    color: #FFFFFF;
    font-weight: 600;
}
QHeaderView::section {
    background-color: #1E293B;
    color: #94A3B8;
    padding: 12px 10px;
    border: none;
    border-bottom: 2px solid #334155;
    border-right: 1px solid #0F172A;
    font-weight: bold;
    font-size: 10pt;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #334155;
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    border: none;
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #334155;
    min-width: 24px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #475569;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    border: none;
    background: none;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #334155;
    border-radius: 8px;
    top: -1px;
    background-color: #0F172A;
}
QTabBar::tab {
    background: #1E293B;
    border: 1px solid #334155;
    color: #94A3B8;
    padding: 10px 20px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 500;
}
QTabBar::tab:selected {
    background: #0F172A;
    color: #3B82F6;
    border-bottom-color: #0F172A;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background: #334155;
    color: #F8FAFC;
}

/* Labels */
QLabel {
    background: transparent;
    color: #F8FAFC;
}
QLabel#titleLabel {
    font-size: 20pt;
    font-weight: 800;
    color: #3B82F6;
    letter-spacing: -0.5px;
}

/* Cards & Frames */
QFrame#cardFrame, QFrame#loginFrame {
    background-color: #1E293B;
    border-radius: 12px;
    border: 1px solid #334155;
}
QFrame#cardFrame:hover {
    border: 1px solid #475569;
}
QFrame#sidebarFrame {
    background-color: #0F172A;
    border-right: 1px solid #1E293B;
    border-radius: 0px;
    border-top: none;
    border-bottom: none;
    border-left: none;
}

/* ComboBox */
QComboBox {
    background-color: #1E293B;
    color: #FFFFFF;
    border: 1.5px solid #475569;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 24px;
    min-width: 220px;
    font-size: 11pt;
}
QComboBox:focus {
    border: 1.5px solid #38BDF8;
    background-color: #0F172A;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #1E293B;
    color: #F8FAFC;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px;
}

/* Sidebar Buttons & Layout */
QPushButton#sidebarBtn {
    background-color: transparent;
    color: #94A3B8;
    text-align: left;
    padding: 12px 18px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 11pt;
}
QPushButton#sidebarBtn:hover {
    background-color: #1E293B;
    color: #F8FAFC;
}
QPushButton#sidebarBtn:pressed {
    background-color: #0F172A;
    color: #3B82F6;
}

/* Sidebar Hamburger Toggle Button */
QPushButton#toggleBtn {
    background-color: #1E293B;
    color: #FFFFFF;
    border: 2px solid #38BDF8;
    border-radius: 8px;
    padding: 0px;
    font-size: 18pt;
    font-weight: bold;
}
QPushButton#toggleBtn:hover {
    background-color: #38BDF8;
    color: #0F172A;
}
QPushButton#toggleBtn:pressed {
    background-color: #0284C7;
    color: #FFFFFF;
}
