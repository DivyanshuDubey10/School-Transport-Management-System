/* =========================================================
   STMS - PREMIUM DARK THEME
   School Transport Management System
   ========================================================= */

QWidget {
    background-color: #0F172A;
    color: #F8FAFC;
    font-family: "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 14px;
}

QLabel {
    background: transparent;
    color: #E2E8F0;
}

QMainWindow, QDialog {
    background-color: #0F172A;
}

/* =========================
   Sidebar
   ========================= */
#sidebarFrame {
    background-color: #1E293B;
    border-right: 1px solid #334155;
}

#sidebarBtn {
    background-color: transparent;
    color: #94A3B8;
    border: none;
    border-radius: 10px;
    padding: 12px 16px;
    text-align: left;
    font-weight: 700;
    font-size: 14px;
}
#sidebarBtn:hover {
    background-color: #334155;
    color: #38BDF8;
}
#sidebarBtn:checked {
    background-color: #0F2942;
    color: #38BDF8;
    border-left: 4px solid #38BDF8;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
}

/* =========================
   Top Bar
   ========================= */
#topBar {
    background-color: rgba(30, 41, 59, 0.85); /* Slightly translucent */
    border-bottom: 1px solid #334155;
}
#titleLabel {
    font-size: 24px;
    font-weight: 800;
    color: #F8FAFC;
    letter-spacing: -0.5px;
}

/* =========================
   Cards & Stats
   ========================= */
#cardFrame, #statCard, QGroupBox {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 16px;
}
QGroupBox {
    margin-top: 14px;
    padding-top: 20px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 20px;
    padding: 0 8px;
    color: #F8FAFC;
    font-weight: 800;
    font-size: 14px;
}
#statTitle {
    color: #94A3B8;
    font-weight: 800;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
#statValue {
    color: #F8FAFC;
    font-weight: 900;
    font-size: 32px;
}
#statDesc {
    color: #CBD5E1;
    font-size: 13px;
    font-weight: 500;
}

/* =========================
   Buttons
   ========================= */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #38BDF8, stop:1 #2563EB);
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 14px;
}
QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #7DD3FC, stop:1 #3B82F6);
}
QPushButton:pressed {
    background-color: #1D4ED8;
}

#actionButton {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1.5px solid #475569;
    border-radius: 12px;
    font-weight: 700;
    font-size: 15px;
    padding: 14px 20px;
    text-align: left;
}
#actionButton:hover {
    background-color: #334155;
    color: #38BDF8;
    border-color: #38BDF8;
}

#secondaryButton {
    background-color: #1E293B;
    color: #E2E8F0;
    border: 1px solid #475569;
    border-radius: 8px;
}
#secondaryButton:hover {
    background-color: #334155;
    color: #F8FAFC;
}

#dangerButton {
    background-color: #451A1A;
    color: #FCA5A5;
    border: 1px solid #7F1D1D;
}
#dangerButton:hover {
    background-color: #7F1D1D;
    color: #FFFFFF;
}

#primaryButton {
    background-color: #14342B;
    color: #4ADE80;
    border: 1px solid #14532D;
}
#primaryButton:hover {
    background-color: #166534;
    color: #FFFFFF;
}

/* =========================
   Inputs & Combo Boxes
   ========================= */
QLineEdit, QComboBox, QSpinBox {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1.5px solid #334155;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1.5px solid #38BDF8;
    background-color: #1E293B;
}

/* =========================
   Tables
   ========================= */
QTableWidget {
    background-color: #1E293B;
    color: #E2E8F0;
    border: none;
    border-radius: 12px;
    gridline-color: #334155;
    selection-background-color: #0F2942;
    selection-color: #38BDF8;
}
QHeaderView::section {
    background-color: #0F172A;
    color: #94A3B8;
    font-weight: 800;
    font-size: 12px;
    text-transform: uppercase;
    padding: 12px;
    border: none;
    border-bottom: 2px solid #334155;
}
QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #334155;
}

/* =========================
   Scrollbars
   ========================= */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #475569;
    min-height: 30px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #64748B;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #475569;
    min-width: 30px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #64748B;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Scroll Area */
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}
