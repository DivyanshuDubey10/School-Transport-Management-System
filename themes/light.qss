/* =========================================================
   STMS - PREMIUM LIGHT THEME
   School Transport Management System
   ========================================================= */

QWidget {
    background-color: #F8FAFC;
    color: #1E293B;
    font-family: "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
    font-size: 14px;
}

QLabel {
    background: transparent;
    color: #334155;
}

QMainWindow, QDialog {
    background-color: #F8FAFC;
}

/* =========================
   Sidebar
   ========================= */
#sidebarFrame {
    background-color: #FFFFFF;
    border-right: 1px solid #E2E8F0;
}

#sidebarBtn {
    background-color: transparent;
    color: #64748B;
    border: none;
    border-radius: 10px;
    padding: 12px 16px;
    text-align: left;
    font-weight: 700;
    font-size: 14px;
}
#sidebarBtn:hover {
    background-color: #F1F5F9;
    color: #0EA5E9;
}
#sidebarBtn:checked {
    background-color: #E0F2FE;
    color: #0284C7;
    border-left: 4px solid #0284C7;
    border-top-left-radius: 0px;
    border-bottom-left-radius: 0px;
}

/* =========================
   Top Bar
   ========================= */
#topBar {
    background-color: rgba(255, 255, 255, 0.85); /* Slightly translucent */
    border-bottom: 1px solid #E2E8F0;
}
#titleLabel {
    font-size: 24px;
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.5px;
}

/* =========================
   Cards & Stats
   ========================= */
#cardFrame, #statCard, QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #F1F5F9;
    border-radius: 16px;
}
QGroupBox {
    margin-top: 14px;
    padding-top: 20px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 20px;
    padding: 0 8px;
    color: #0F172A;
    font-weight: 800;
    font-size: 14px;
}
#statTitle {
    color: #64748B;
    font-weight: 800;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}
#statValue {
    color: #0F172A;
    font-weight: 900;
    font-size: 32px;
}
#statDesc {
    color: #94A3B8;
    font-size: 13px;
    font-weight: 500;
}

/* =========================
   Buttons
   ========================= */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #38BDF8, stop:1 #2563EB);
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 700;
    font-size: 14px;
}
QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #0EA5E9, stop:1 #1D4ED8);
}
QPushButton:pressed {
    background-color: #1E40AF;
}

#actionButton {
    background-color: #FFFFFF;
    color: #0F172A;
    border: 1.5px solid #E2E8F0;
    border-radius: 12px;
    font-weight: 700;
    font-size: 15px;
    padding: 14px 20px;
    text-align: left;
}
#actionButton:hover {
    background-color: #F8FAFC;
    color: #0284C7;
    border-color: #BAE6FD;
}

#secondaryButton {
    background-color: #FFFFFF;
    color: #475569;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
}
#secondaryButton:hover {
    background-color: #F1F5F9;
    color: #0F172A;
}

#dangerButton {
    background-color: #FEF2F2;
    color: #DC2626;
    border: 1px solid #FECACA;
}
#dangerButton:hover {
    background-color: #FEE2E2;
    border: 1px solid #FCA5A5;
}

#primaryButton {
    background-color: #F0Fdf4;
    color: #16A34A;
    border: 1px solid #bbf7d0;
}
#primaryButton:hover {
    background-color: #dcfce7;
}

/* =========================
   Inputs & Combo Boxes
   ========================= */
QLineEdit, QComboBox, QSpinBox {
    background-color: #F8FAFC;
    color: #0F172A;
    border: 1.5px solid #E2E8F0;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 14px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1.5px solid #38BDF8;
    background-color: #FFFFFF;
}

/* =========================
   Tables
   ========================= */
QTableWidget {
    background-color: #FFFFFF;
    color: #334155;
    border: none;
    border-radius: 12px;
    gridline-color: #F1F5F9;
    selection-background-color: #E0F2FE;
    selection-color: #0284C7;
}
QHeaderView::section {
    background-color: #F8FAFC;
    color: #64748B;
    font-weight: 800;
    font-size: 12px;
    text-transform: uppercase;
    padding: 12px;
    border: none;
    border-bottom: 2px solid #E2E8F0;
}
QTableWidget::item {
    padding: 12px;
    border-bottom: 1px solid #F1F5F9;
}

/* =========================
   Scrollbars
   ========================= */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    min-height: 30px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    min-width: 30px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Scroll Area */
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}
