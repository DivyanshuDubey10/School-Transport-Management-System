# NeoYatra Backend — Environment Variables Template
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------
# Option A: Full Connection URL (standard on Railway, Render, Supabase, Neon)
# DATABASE_URL=postgresql://user:password@host:5432/stms_db

# Option B: Discrete Parameters
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stms_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# ---------------------------------------------------------------------------
# Security & JWT
# ---------------------------------------------------------------------------
# Generate a strong 32+ character random string for production
JWT_SECRET=neoyatra-production-super-secret-jwt-key-2026
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Default administrator credentials created on initial database boot
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ---------------------------------------------------------------------------
# Networking & CORS
# ---------------------------------------------------------------------------
# Comma-separated allowed frontend origins (use * for all, or domain URL)
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend-app.vercel.app
ENVIRONMENT=production
